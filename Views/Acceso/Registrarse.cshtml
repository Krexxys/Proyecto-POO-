@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registrarse - Control de Acceso</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f0f3f8;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem 0;
        }
        .reg-card {
            width: 100%;
            max-width: 470px;
            border: none;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(13, 27, 62, 0.12);
        }
        .reg-banner {
            background: linear-gradient(135deg, #0b1938 0%, #162e66 100%);
            color: #ffffff;
            padding: 1.75rem;
        }
        .btn-navy {
            background: linear-gradient(135deg, #0b1938 0%, #162e66 100%);
            color: #fff;
            border: none;
            font-weight: 600;
            padding: 0.65rem;
            border-radius: 10px;
        }
        .btn-navy:hover {
            opacity: 0.94;
            color: #fff;
        }
        .regla-ok { color: #198754; }
        .regla-pendiente { color: #6c757d; }
    </style>
</head>
<body>

    <div class="card reg-card bg-white">
        <div class="reg-banner">
            <h3 class="fw-bold mb-1">Crear Nueva Cuenta</h3>
            <p class="mb-0 text-white-50 small">Regístrate con tu puesto operativo asignado.</p>
        </div>

        <div class="card-body p-4">
            @if (TempData["ErrorRegistro"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show small" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-1"></i> @TempData["ErrorRegistro"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-controller="Acceso" asp-action="Registrarse" method="post" id="formRegistro">
                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Nombre de Usuario</label>
                    <input type="text" name="NombreUsuario" class="form-control" placeholder="Ej. CarlosM" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Correo Electrónico</label>
                    <input type="email" name="Correo" class="form-control" placeholder="carlos@prueba.com" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Puesto / Rango</label>
                    <select name="Puesto" class="form-select" required>
                        <option value="" disabled selected>Selecciona tu puesto...</option>
                        <option value="BOH TM">BOH TM</option>
                        <option value="MOH TM">MOH TM</option>
                        <option value="FOH TM">FOH TM</option>
                    </select>
                </div>

                <div class="mb-2">
                    <label class="form-label fw-semibold text-secondary small">Contraseña</label>
                    <input type="password" id="regPassword" name="Password" class="form-control"
                           pattern="(?=.*[A-Z])(?=.*\d).{8,}"
                           title="Mínimo 8 caracteres, 1 letra mayúscula y 1 número"
                           placeholder="Mínimo 8 caracteres" required />
                </div>

                <!-- Indicador visual de requisitos de seguridad -->
                <ul class="list-unstyled small mb-3 ps-1">
                    <li id="reqLen" class="regla-pendiente"><i class="bi bi-circle me-1"></i> Mínimo 8 caracteres</li>
                    <li id="reqUpper" class="regla-pendiente"><i class="bi bi-circle me-1"></i> Al menos 1 letra mayúscula</li>
                    <li id="reqNum" class="regla-pendiente"><i class="bi bi-circle me-1"></i> Al menos 1 carácter numérico</li>
                </ul>

                <div class="mb-4">
                    <label class="form-label fw-semibold text-secondary small">Confirmar Contraseña</label>
                    <input type="password" name="ConfirmarPassword" class="form-control" placeholder="Repite tu contraseña" required />
                </div>

                <button type="submit" class="btn btn-navy w-100 mb-3">
                    <i class="bi bi-check2-circle me-1"></i> Completar Registro
                </button>

                <div class="text-center">
                    <a asp-controller="Acceso" asp-action="Login" class="text-decoration-none small fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> Volver al Inicio de Sesión
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const inputPass = document.getElementById("regPassword");
        const reqLen = document.getElementById("reqLen");
        const reqUpper = document.getElementById("reqUpper");
        const reqNum = document.getElementById("reqNum");

        function actualizarRegla(elemento, cumple) {
            elemento.className = cumple ? "regla-ok fw-semibold" : "regla-pendiente";
            elemento.querySelector("i").className = cumple ? "bi bi-check-circle-fill me-1" : "bi bi-circle me-1";
        }

        inputPass.addEventListener("input", function () {
            const val = this.value;
            actualizarRegla(reqLen, val.length >= 8);
            actualizarRegla(reqUpper, /[A-Z]/.test(val));
            actualizarRegla(reqNum, /[0-9]/.test(val));
        });
    </script>
</body>
</html>