@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Control de Acceso</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f0f3f8;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            width: 100%;
            max-width: 430px;
            border: none;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(13, 27, 62, 0.12);
        }
        .login-banner {
            background: linear-gradient(135deg, #0b1938 0%, #162e66 100%);
            color: #ffffff;
            padding: 2rem 1.75rem 1.75rem;
        }
        .badge-seguridad {
            background-color: #157347;
            color: #fff;
            font-size: 0.78rem;
            padding: 0.35rem 0.75rem;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 0.85rem;
        }
        .btn-navy {
            background: linear-gradient(135deg, #0b1938 0%, #162e66 100%);
            color: #fff;
            border: none;
            font-weight: 600;
            padding: 0.65rem;
            border-radius: 10px;
        }
        .btn-navy:hover {
            opacity: 0.94;
            color: #fff;
        }
    </style>
</head>
<body>

    <div class="card login-card bg-white">
        <div class="login-banner">
            <div class="badge-seguridad">
                <span style="width:8px;height:8px;background:#75f5a6;border-radius:50%;display:inline-block;"></span>
                Sistema de Control de Acceso
            </div>
            <h3 class="fw-bold mb-1">Iniciar Sesión</h3>
            <p class="mb-0 text-white-50 small">Ingresa tus credenciales para acceder al panel principal.</p>
        </div>

        <div class="card-body p-4">
            @if (TempData["ExitoRegistro"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show small" role="alert">
                    <i class="bi bi-check-circle-fill me-1"></i> @TempData["ExitoRegistro"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-controller="Acceso" asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Usuario o Correo Electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                        <input type="text" name="usuarioOcorreo" class="form-control" placeholder="Ej. Nehemias" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold text-secondary small">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                        <input type="password" name="password" class="form-control" placeholder="••••••••" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-navy w-100 mb-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Ingresar
                </button>
            </form>

            <hr class="text-muted my-3" />

            <div class="text-center">
                <span class="text-muted small d-block mb-2">¿Aún no tienes una cuenta asignada?</span>
                <a asp-controller="Acceso" asp-action="Registrarse" class="btn btn-outline-primary w-100 fw-semibold" style="border-radius:10px;">
                    <i class="bi bi-person-plus me-1"></i> Registrarse
                </a>
            </div>
        </div>
    </div>

    <!-- Ventana Emergente (Modal) de Error -->
    @if (TempData["ErrorLogin"] != null)
    {
        <div class="modal fade" id="modalErrorLogin" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Error de Autenticación</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body py-4">
                        <p class="mb-0">@TempData["ErrorLogin"]</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Intentar de nuevo</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var modalElement = document.getElementById('modalErrorLogin');
            if (modalElement) {
                var modalError = new bootstrap.Modal(modalElement);
                modalError.show();
            }
        });
    </script>
</body>
</html>