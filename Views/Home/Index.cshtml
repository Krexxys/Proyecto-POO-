@model List<SistemaLoginMVC.Models.Usuario>
@{
    ViewData["Title"] = "Panel Principal";
    Layout = null;
    bool esAdmin = ViewBag.EsAdmin ?? false;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel Principal - Control de Acceso</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f0f3f8;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            padding: 2rem 0 3rem;
        }
        .hero-banner {
            background: linear-gradient(135deg, #0b1938 0%, #162e66 100%);
            border-radius: 16px;
            padding: 2rem 2.25rem;
            color: #ffffff;
            box-shadow: 0 10px 25px rgba(11, 25, 56, 0.14);
        }
        .badge-verificada {
            background-color: #157347;
            color: #ffffff;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.35rem 0.85rem;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 0.9rem;
        }
        .btn-logout-white {
            background-color: #ffffff;
            color: #1f2937;
            font-weight: 600;
            border-radius: 10px;
            padding: 0.6rem 1.2rem;
            border: none;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-logout-white:hover {
            background-color: #f8fafc;
            color: #dc3545;
        }
        .info-card {
            background-color: #ffffff;
            border: none;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
            height: 100%;
        }
        .icon-box {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
        }
        .icon-blue { background-color: #e8efff; color: #2563eb; }
        .icon-green { background-color: #e6f7ee; color: #16a34a; }
        .icon-cyan { background-color: #e0f7fa; color: #0891b2; }
        .card-label {
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #64748b;
            text-transform: uppercase;
        }
        .card-main-value {
            font-size: 1.35rem;
            font-weight: 700;
            color: #0f172a;
        }
        .section-card {
            background-color: #ffffff;
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
            overflow: hidden;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Banner Superior Estilo Dashboard -->
        <div class="hero-banner mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div>
                    <div class="badge-verificada">
                        <span style="width:8px;height:8px;background:#75f5a6;border-radius:50%;display:inline-block;"></span>
                        Sesión activa verificada
                    </div>
                    <h2 class="fw-bold mb-1">Bienvenido @ViewBag.NombreUsuario, gracias por visitarnos</h2>
                    <p class="mb-0 text-white-50">Has ingresado correctamente al Panel Principal del Sistema de Control de Acceso.</p>
                </div>

                <div>
                    <a asp-controller="Acceso" asp-action="CerrarSesion" class="btn-logout-white">
                        <i class="bi bi-box-arrow-right text-danger"></i> Cerrar Sesión
                    </a>
                </div>
            </div>
        </div>

        <!-- 3 Tarjetas de Resumen del Usuario Activo -->
        <div class="row g-4 mb-4">
            <!-- Tarjeta 1: Perfil de Usuario -->
            <div class="col-md-4">
                <div class="info-card">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icon-box icon-blue">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <div>
                            <div class="card-label">Perfil de Usuario</div>
                            <div class="card-main-value">ID #@ViewBag.UsuarioId</div>
                        </div>
                    </div>
                    <hr class="text-muted my-3" />
                    <div class="small text-secondary mb-1">
                        <strong class="text-dark">Nombre:</strong> @ViewBag.NombreUsuario
                    </div>
                    <div class="small text-secondary">
                        <strong class="text-dark">Correo:</strong> @ViewBag.CorreoUsuario
                    </div>
                </div>
            </div>

            <!-- Tarjeta 2: Actividad de Acceso -->
            <div class="col-md-4">
                <div class="info-card">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icon-box icon-green">
                            <i class="bi bi-clock"></i>
                        </div>
                        <div>
                            <div class="card-label">Actividad de Acceso</div>
                            <div class="card-main-value">En línea</div>
                        </div>
                    </div>
                    <hr class="text-muted my-3" />
                    <div class="small text-secondary mb-1">
                        <strong class="text-dark">Sesión actual:</strong> @ViewBag.SesionActual
                    </div>
                    <div class="small text-secondary">
                        <strong class="text-dark">Acceso anterior:</strong> @ViewBag.AccesoAnterior
                    </div>
                </div>
            </div>

            <!-- Tarjeta 3: Nivel y Seguridad -->
            <div class="col-md-4">
                <div class="info-card">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icon-box icon-cyan">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div>
                            <div class="card-label">Nivel y Seguridad</div>
                            <div class="card-main-value">@ViewBag.PuestoUsuario</div>
                        </div>
                    </div>
                    <hr class="text-muted my-3" />
                    <div class="small text-secondary mb-1">
                        <strong class="text-dark">Base de datos:</strong> SQL Server
                    </div>
                    <div class="small text-secondary">
                        <strong class="text-dark">Cifrado:</strong> SHA-256 + Session Auth
                    </div>
                </div>
            </div>
        </div>

        <!-- Alertas de Confirmación / Error -->
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm">
                <i class="bi bi-check-circle-fill me-1"></i> @TempData["MensajeExito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["MensajeError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Formulario Agregar Usuario (Solo visible para el Administrador Nehemias) -->
        @if (esAdmin)
        {
            <div class="section-card mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-person-plus-fill text-primary me-2"></i>Agregar Nuevo Usuario</h6>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Home" asp-action="AgregarUsuario" method="post" class="row g-3">
                        <div class="col-md-3">
                            <input type="text" name="NombreUsuario" class="form-control" placeholder="Nombre de Usuario" required />
                        </div>
                        <div class="col-md-3">
                            <input type="email" name="Correo" class="form-control" placeholder="Correo electrónico" required />
                        </div>
                        <div class="col-md-2">
                            <select name="Puesto" class="form-select" required>
                                <option value="BOH TM">BOH TM</option>
                                <option value="MOH TM">MOH TM</option>
                                <option value="FOH TM" selected>FOH TM</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <input type="password" name="Password" class="form-control"
                                   pattern="(?=.*[A-Z])(?=.*\d).{8,}"
                                   title="Mínimo 8 caracteres, 1 mayúscula y 1 número"
                                   placeholder="Contraseña segura" required />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100 fw-semibold">
                                <i class="bi bi-plus-lg"></i> Agregar
                            </button>
                        </div>
                    </form>
                    <small class="text-muted d-block mt-2">
                        Requisito de contraseña: mínimo 8 caracteres, al menos 1 letra mayúscula y 1 número.
                    </small>
                </div>
            </div>
        }

        <!-- Tabla de Usuarios y Auditoría -->
        <div class="section-card">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-people-fill text-primary me-2"></i>Usuarios Registrados en Base de Datos</h6>
                @if (!esAdmin)
                {
                    <span class="badge bg-secondary">Modo Lectura (@ViewBag.PuestoUsuario)</span>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Usuario</th>
                            <th>Puesto</th>
                            <th>Correo</th>
                            <th>Último Ingreso</th>
                            <th>Creación</th>
                            <th>Modificación</th>
                            <th>Eliminación</th>
                            <th class="pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            bool esNehemias = string.Equals(item.NombreUsuario, "Nehemias", StringComparison.OrdinalIgnoreCase);

                            <tr class="@(item.FechaEliminacion != null ? "table-danger text-muted" : "")">
                                <td class="ps-4 fw-bold">#@item.Id</td>
                                <td><strong>@item.NombreUsuario</strong></td>
                                <td>
                                    @if (item.Puesto == "Administrador")
                                    {
                                        <span class="badge bg-primary">@item.Puesto</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">@item.Puesto</span>
                                    }
                                </td>
                                <td>@item.Correo</td>
                                <td>@(item.UltimoIngreso?.ToString("dd/MM/yyyy HH:mm") ?? "Sin ingresos")</td>
                                <td>@item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(item.FechaModificacion?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                <td>@(item.FechaEliminacion?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                <td class="pe-4">
                                    @if (esNehemias)
                                    {
                                        <span class="badge bg-dark"><i class="bi bi-lock-fill me-1"></i>Protegido</span>
                                    }
                                    else if (!esAdmin)
                                    {
                                        <span class="text-muted small">Sin permisos</span>
                                    }
                                    else if (item.FechaEliminacion == null)
                                    {
                                        <button type="button"
                                                class="btn btn-warning btn-sm me-1 btn-editar"
                                                data-id="@item.Id"
                                                data-usuario="@item.NombreUsuario"
                                                data-correo="@item.Correo"
                                                data-puesto="@item.Puesto"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEditarUsuario">
                                            Editar
                                        </button>

                                        <form asp-controller="Home" asp-action="EliminarUsuario" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Seguro que deseas quitar este usuario?');">
                                                Quitar
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger me-1">Eliminado</span>
                                        <form asp-controller="Home" asp-action="RestaurarUsuario" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('¿Deseas restaurar este usuario?');">
                                                Restaurar
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Editar Usuario (Solo Administrador) -->
    @if (esAdmin)
    {
        <div class="modal fade" id="modalEditarUsuario" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <form asp-controller="Home" asp-action="EditarUsuario" method="post">
                        <div class="modal-header bg-warning">
                            <h5 class="modal-title text-dark fw-bold">Editar Usuario</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" id="editId" name="Id" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Nombre de Usuario</label>
                                <input type="text" id="editNombreUsuario" name="NombreUsuario" class="form-control" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Correo Electrónico</label>
                                <input type="email" id="editCorreo" name="Correo" class="form-control" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Puesto / Rango</label>
                                <select id="editPuesto" name="Puesto" class="form-select" required>
                                    <option value="BOH TM">BOH TM</option>
                                    <option value="MOH TM">MOH TM</option>
                                    <option value="FOH TM">FOH TM</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Nueva Contraseña (opcional)</label>
                                <input type="password" id="editNuevaPassword" name="NuevaPassword" class="form-control"
                                       pattern="(?=.*[A-Z])(?=.*\d).{8,}"
                                       title="Si escribes una contraseña nueva, debe tener mínimo 8 caracteres, 1 mayúscula y 1 número"
                                       placeholder="Déjalo vacío para mantener la actual" />
                                <small class="text-muted">Si la cambias: mínimo 8 caracteres, 1 mayúscula y 1 número.</small>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".btn-editar").forEach(function (boton) {
                boton.addEventListener("click", function () {
                    document.getElementById("editId").value = this.getAttribute("data-id");
                    document.getElementById("editNombreUsuario").value = this.getAttribute("data-usuario");
                    document.getElementById("editCorreo").value = this.getAttribute("data-correo");
                    document.getElementById("editPuesto").value = this.getAttribute("data-puesto");
                    document.getElementById("editNuevaPassword").value = "";
                });
            });
        });
    </script>
</body>
</html>